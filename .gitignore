# =============================
# Projeto simples (HTML/CV)
# Ignore arquivos locais e temporarios
# =============================

# Sistema operacional
.DS_Store
Thumbs.db
Desktop.ini

# Logs e temporarios
*.log
*.tmp
*.temp

# Arquivos de editor/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.code-workspace

# Dependencias e builds (caso evolua o projeto)
node_modules/
dist/
build/
coverage/
out/

# Variaveis de ambiente
.env
.env.*
!.env.example

# Python/Jupyter (caso use scripts auxiliares)
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Arquivos compactados/exportados
*.zip
*.rar
*.7z
